{
  "name": "@cododel/alto",
  "version": "0.1.8",
  "description": "A powerful CLI tool for directus",
  "keywords": [
    "cli",
    "typescript",
    "directus",
    "code-generation"
  ],
  "author": "Alexander Smith <websmithcode@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cododel/alto.git"
  },
  "bugs": {
    "url": "https://github.com/cododel/alto/issues"
  },
  "homepage": "https://github.com/cododel/alto#readme",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "type": "module",
  "bin": {
    "alto": "dist/index.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./cli": "./dist/cli.js"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "alto": "bun ./src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target node --minify --external consola --external enquirer --external execa --external yargs --external ts-pattern --external pluralize --external jiti --external nunjucks --external prettier --external fast-glob --external eventemitter2 --external chokidar --external @directus/sdk --external zod && cp -r src/commands/types/cli/default dist/default",
    "prepublishOnly": "bun run build",
    "test:install": "./scripts/test-install.sh",
    "test:uninstall": "./scripts/test-uninstall.sh",
    "test:full-cycle": "./scripts/test-full-cycle.sh"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/execa": "^2.0.2",
    "@types/nunjucks": "^3.2.6",
    "@types/pluralize": "^0.0.33",
    "@types/yargs": "^17.0.33"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@directus/sdk": "^21.1.0",
    "chokidar": "^5.0.0",
    "consola": "^3.4.2",
    "enquirer": "^2.4.1",
    "eventemitter2": "^6.4.9",
    "execa": "^9.6.0",
    "fast-glob": "^3.3.3",
    "jiti": "^2.6.1",
    "nunjucks": "^3.2.4",
    "pluralize": "^8.0.0",
    "prettier": "^3.8.1",
    "ts-pattern": "^5.9.0",
    "yargs": "^18.0.0",
    "zod": "^4.3.6"
  },
  "workspaces": [
    "src/commands/*"
  ]
}
